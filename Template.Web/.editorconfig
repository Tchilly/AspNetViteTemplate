root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{cs,vb}]
indent_size = 4

[*.{js,jsx,ts,tsx,json,yml,yaml}]
indent_size = 2

[*.{html,cshtml,razor}]
indent_size = 2

[*.{css,scss,less}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
